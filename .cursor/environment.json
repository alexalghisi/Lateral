{
  "name": "Lateral",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "api",
      "command": "cd /workspace && . .venv/bin/activate && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
    },
    {
      "name": "web",
      "command": "cd /workspace/frontend && VITE_API_TARGET=http://localhost:8000 npm run dev -- --host 0.0.0.0 --port 5173"
    }
  ],
  "ports": [
    { "name": "api", "port": 8000 },
    { "name": "web", "port": 5173 }
  ]
}
