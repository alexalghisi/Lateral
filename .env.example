# ---------------------------------------------------------------------------
# Environment contract.
#
# Copy to `.env` and adjust. `.env` is git-ignored; this file is the tracked,
# placeholder-only documentation of every variable the application reads.
#
# ARCHITECTURAL DECISION: configuration is supplied exclusively through the
# environment (12-factor). There are no per-environment settings modules and no
# `if ENV == "production"` branches in application code. The same image runs in
# every environment; only the injected environment differs.
# ---------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
# Free-form environment label. Used for diagnostics and to decide whether the
# interactive API documentation is exposed.
APP_ENV=local

# Log verbosity for both the application and Uvicorn.
LOG_LEVEL=info

# Secret used to sign tokens and any other keyed material.
# MUST be overridden with a high-entropy value outside local development, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-every-real-environment

# --- PostgreSQL --------------------------------------------------------------
# The connection URL is assembled from these parts in app/core/config.py rather
# than being supplied whole. This keeps the password a discrete, individually
# injectable secret instead of embedding it in a larger string, which matters
# when credentials come from a secret manager.
POSTGRES_USER=lateral
POSTGRES_PASSWORD=lateral
POSTGRES_DB=lateral

# Hostname as seen from the API container. `db` is the Compose service name.
# Use `localhost` when running the application directly on the host.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Host port mappings ------------------------------------------------------
# Only consumed by docker-compose.yml, never by the application itself.
# The public entrypoint is Nginx; the API port is exposed purely for debugging.
NGINX_HOST_PORT=8080
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
